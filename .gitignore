# Python caches and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg
*.egg-info/
.eggs/
wheels/

# Virtual environments and local configuration
.env
.env.*
!.env.example
!examples/**/.env.example
.venv/
env/
venv/
ENV/

# Test, type-checker, and notebook caches
.cache/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
.mypy_cache/
.dmypy.json
.ipynb_checkpoints/

# Editors, OS files, and local agent configuration
.idea/
.vscode/
.claude/
.agents/
.DS_Store
Thumbs.db
*.swp
*.swo
*.swn
*~

# Logs and temporary runtime files
*.log
logs/
new_plan/
pip-log.txt
pip-delete-this-directory.txt
*.tmp
*.temp

# Personal notes and local handoff material
ignore_files/
HANDOFF.md
EXPERIENCE.md

# Private credentials and certificates
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json

# Model weights and training outputs
checkpoint-*/
checkpoint-*-merged/
output/
outputs/
rl/output/
*.safetensors
*.ckpt
*.pth
*.pt
*.gguf

# Raw, generated, and duplicated training data. The small reviewed synthetic
# second-Schema dataset is intentionally published for reproducibility.
data/*
!data/frozen/
!data/frozen/intent_routing_v1/
!data/frozen/intent_routing_v1/**
data_zip/
rl/data/

# Local or historical audit bundles. Only the sanitized second-Schema result
# package is published.
reports/*
!reports/second_schema/
!reports/second_schema/**
reports/second_schema/*.log

# Local lock files (the project currently uses requirements*.txt)
pdm.lock
uv.lock
poetry.lock
Pipfile.lock
